# Required for chat and web search
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key

# Optional: required only for the corresponding tool
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional: defaults to the project directory locally; use /data with ECS/EFS
APP_DATA_DIR=.